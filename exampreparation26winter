                "Có thể linh hoạt sắp xếp cùng lịch dạy thêm và tập gym."
            )

            uid = (
                f"study-{subject}-"
                f"{event_date.strftime('%Y%m%d')}@exam-preparation"
            )

            events.append(
                make_event(
                    uid,
                    event_date,
                    summary,
                    description,
                    f"Study,{subject}",
                )
            )

    # Confirmed exam events
    for exam in exams:
        subject = exam["subject"]
        subject_name = SUBJECTS[subject]
        exam_date = exam["date"]
        session = exam["session"]

        summary = f"🎓 EXAM | {subject} – {subject_name}"

        description = (
            f"Kỳ thi: {subject_name} ({subject})\n"
            f"Ngày thi: {exam_date.strftime('%d/%m/%Y')}\n"
            f"Buổi thi: {session}\n"
            "Thời gian cụ thể chưa được cung cấp."
        )

        uid = (
            f"exam-{subject}-"
            f"{exam_date.strftime('%Y%m%d')}@exam-preparation"
        )

        events.append(
            make_event(
                uid,
                exam_date,
                summary,
                description,
                f"Exam,{subject}",
            )
        )

    calendar_lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Exam Preparation//Nguyen//VI",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        "X-WR-CALNAME:Exam Preparation 2026-2027",
        "X-WR-CALDESC:Study targets and confirmed exam dates",
        *events,
        "END:VCALENDAR",
    ]

    content = "\r\n".join(calendar_lines) + "\r\n"

    output_path = Path(OUTPUT_FILE)
    output_path.write_text(content, encoding="utf-8", newline="")

