# ==========================================
# ICS GENERATOR
# ==========================================

def escape_ics(text):
    """Escape special characters for ICS text fields."""
    return (
        str(text)
        .replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\n", "\\n")
    )


def format_hours(hours):
    """Format hours without unnecessary decimal zeros."""
    if float(hours).is_integer():
        return str(int(hours))
    return str(hours).replace(".", ",")


def fold_line(line):
    """
    Fold long ICS lines according to RFC 5545.
    Continuation lines begin with one space.
    """
    result = []
    current_line = ""
    current_bytes = 0

    for char in line:
        char_bytes = len(char.encode("utf-8"))

        if current_bytes + char_bytes > 73:
            result.append(current_line)
            current_line = " " + char
            current_bytes = 1 + char_bytes
        else:
            current_line += char
            current_bytes += char_bytes

    result.append(current_line)
    return "\r\n".join(result)


def make_event(uid, event_date, summary, description, categories):
    start = event_date.strftime("%Y%m%d")
    end = (event_date + timedelta(days=1)).strftime("%Y%m%d")

    now = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

    lines = [
        "BEGIN:VEVENT",
        f"UID:{uid}",
        f"DTSTAMP:{now}",
        f"DTSTART;VALUE=DATE:{start}",
        f"DTEND;VALUE=DATE:{end}",
        f"SUMMARY:{escape_ics(summary)}",
        f"DESCRIPTION:{escape_ics(description)}",
        f"CATEGORIES:{escape_ics(categories)}",
        "TRANSP:TRANSPARENT",
        "STATUS:CONFIRMED",
        "END:VEVENT",
    ]

    return "\r\n".join(fold_line(line) for line in lines)


